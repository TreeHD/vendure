# Gallery backend baseline. Copy these values into your local environment.
DB=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=vendure
DB_PASSWORD=change-me
DB_NAME=gallery
DB_SCHEMA=public

# Use true only for a disposable local database. Production must set this to false and use migrations.
DB_SYNCHRONIZE=true

VENDURE_COOKIE_SECRET=replace-with-at-least-32-random-characters
SUPERADMIN_USERNAME=replace-me
SUPERADMIN_PASSWORD=replace-with-a-strong-password
VENDURE_CORS_ORIGINS=*
VENDURE_TRUST_PROXY=false
VENDURE_SERVE_GRAPHIQL=true
VENDURE_SERVE_SWAGGER=true
VENDURE_SERVE_STATIC_DASHBOARD=true

# Customer email links point to the storefront. Match these paths to the Nuxt routes.
VENDURE_STOREFRONT_URL=http://localhost:3000
VENDURE_VERIFY_EMAIL_URL=http://localhost:3000/account/verify
VENDURE_PASSWORD_RESET_URL=http://localhost:3000/account/reset-password
VENDURE_CHANGE_EMAIL_URL=http://localhost:3000/account/change-email-address
EMAIL_FROM_ADDRESS=Gallery <noreply@example.test>

# Stripe hosted Checkout. Use test keys locally; the webhook endpoint is
# POST /payments/stripe/webhook and must receive Stripe's raw signed payload.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Empty SMTP_HOST uses the local /mailbox preview; production requires SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Production requires a persistent mounted directory and its public URL prefix.
# This storage is PUBLIC; never upload private originals here.
VENDURE_ASSET_UPLOAD_DIR=
VENDURE_ASSET_URL_PREFIX=
