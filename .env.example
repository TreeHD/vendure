# Copy this file to .env, then replace credentials and provider values.

# Compose / image
APP_IMAGE=vendure-app
APP_BUILD_CONTEXT=.
APP_DOCKERFILE=Dockerfile
APP_HOST_PORT=3000
APP_CONTAINER_PORT=3000
NODE_ENV=development

# Database
DB=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=vendure
DB_USERNAME=vendure
DB_PASSWORD=change-this-database-password
DB_SYNCHRONIZE=false
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=vendure
POSTGRES_USER=vendure
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DEPENDS_ON_CONDITION=service_healthy
POSTGRES_HEALTHCHECK_INTERVAL=5s
POSTGRES_HEALTHCHECK_TIMEOUT=5s
POSTGRES_HEALTHCHECK_RETRIES=10
POSTGRES_DATA_PATH=/var/lib/postgresql/data
POSTGRES_VOLUME_NAME=vendure_postgres_data

# Vendure application
VENDURE_COOKIE_SECRET=replace-with-a-random-secret-at-least-32-characters
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=replace-with-a-strong-password
VENDURE_STOREFRONT_URL=http://localhost:3000
VENDURE_CORS_ORIGINS=*
VENDURE_TRUST_PROXY=false
VENDURE_ASSET_UPLOAD_DIR=/app/assets
VENDURE_ASSET_URL_PREFIX=http://localhost:3000/assets/
VENDURE_SERVE_STATIC_DASHBOARD=true
VENDURE_SERVE_GRAPHIQL=false
VENDURE_SERVE_SWAGGER=true
VENDURE_VERIFY_EMAIL_URL=http://localhost:3000/account/verify
VENDURE_PASSWORD_RESET_URL=http://localhost:3000/account/reset-password
VENDURE_CHANGE_EMAIL_URL=http://localhost:3000/account/change-email-address
ASSET_VOLUME_NAME=vendure_vendure_assets

# SMTP (leave SMTP_HOST empty to use the development mailbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=Gallery <noreply@example.test>

# Stripe: required to create hosted Checkout pages and verify webhooks.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# S3-compatible asset storage (set S3_BUCKET to enable it)
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
